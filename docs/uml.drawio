        <mxCell id="cls_cf" value="&lt;b&gt;CollaborativeRecommender&lt;/b&gt;&#xa;──────────────────&#xa;- _movies, _matrix, _movie_idx&#xa;──────────────────&#xa;+ recommend(watched_ids, top_k): List[dict]&#xa;- _svd_predict(matrix, k): ndarray" style="shape=mxgraph.basic.rect;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="300" height="130" as="geometry"/>
        </mxCell>

        <!-- HybridRecommender -->
        <mxCell id="cls_hy" value="&lt;b&gt;HybridRecommender&lt;/b&gt;&#xa;──────────────────&#xa;- _cw: float&#xa;──────────────────&#xa;+ recommend(content, collab, top_k): List[dict]" style="shape=mxgraph.basic.rect;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="320" width="300" height="110" as="geometry"/>
        </mxCell>

        <!-- SequentialRecommender -->
        <mxCell id="cls_sq" value="&lt;b&gt;SequentialRecommender&lt;/b&gt;&#xa;──────────────────&#xa;- _transitions: Dict&#xa;──────────────────&#xa;+ recommend(watched_ids, top_k): List[dict]&#xa;- _build_transitions(): Dict" style="shape=mxgraph.basic.rect;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="300" height="130" as="geometry"/>
        </mxCell>

        <!-- RecommendationPipeline -->
        <mxCell id="cls_rp" value="&lt;b&gt;RecommendationPipeline&lt;/b&gt;&#xa;──────────────────&#xa;- _classifier: TitleClassifier&#xa;- _content: ContentBasedRecommender&#xa;- _collab: CollaborativeRecommender&#xa;- _hybrid: HybridRecommender&#xa;- _sequential: SequentialRecommender&#xa;──────────────────&#xa;+ run(watched_titles): Dict&#xa;- _build_retrieval_context(titles): List" style="shape=mxgraph.basic.rect;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;fontStyle=0;" vertex="1" parent="1">
