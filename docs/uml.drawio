<mxfile host="app.diagrams.net" modified="2026-04-01T00:00:00.000Z" agent="CineMatch" version="24.0.0" type="device">
  <diagram id="uml" name="UML Class Diagram">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Database -->
        <mxCell id="cls_db" value="&lt;b&gt;Database&lt;/b&gt;&#xa;«Singleton»&#xa;──────────────────&#xa;- _instance: Database&#xa;- _initialized: bool&#xa;──────────────────&#xa;+ init(): void&#xa;+ register_user(username, password): dict&#xa;+ login_user(username, password): dict&#xa;+ get_user_by_token(token): dict | None&#xa;+ log_recommendation(user_id, titles): void" style="shape=mxgraph.basic.rect;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="200" as="geometry"/>
        </mxCell>

        <!-- MovieDataset -->
        <mxCell id="cls_md" value="&lt;b&gt;MovieDataset&lt;/b&gt;&#xa;──────────────────&#xa;+ MOVIES: List[dict]&#xa;+ USER_INTERACTIONS: Dict&#xa;+ USER_SEQUENCES: List[List[int]]&#xa;──────────────────&#xa;+ get_movie_map(): Dict[int, dict]&#xa;+ get_title_index(): Dict[str, dict]" style="shape=mxgraph.basic.rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="300" height="170" as="geometry"/>
        </mxCell>

        <!-- TitleClassifier -->
        <mxCell id="cls_tc" value="&lt;b&gt;TitleClassifier&lt;/b&gt;&#xa;──────────────────&#xa;- _index: Dict[str, dict]&#xa;──────────────────&#xa;+ classify(titles): List[dict]&#xa;+ resolve_ids(titles): Tuple&#xa;+ format_recommendation(...): dict" style="shape=mxgraph.basic.rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="300" height="150" as="geometry"/>
        </mxCell>

        <!-- ContentBasedRecommender -->
        <mxCell id="cls_cb" value="&lt;b&gt;ContentBasedRecommender&lt;/b&gt;&#xa;──────────────────&#xa;- _movies, _tfidf, _matrix&#xa;──────────────────&#xa;+ recommend(watched_ids, top_k): List[dict]&#xa;- _build_corpus(): List[str]" style="shape=mxgraph.basic.rect;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
